# Copy to .env.local and fill from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Testing only: shows a "Visitor pass" at the gate (needs Supabase anonymous sign-ins). Never set in production.
NEXT_PUBLIC_VISITOR_PASS=true
